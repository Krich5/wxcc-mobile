# --- Server ---
PORT=8080
SESSION_SECRET=change-me-to-a-random-string

# --- Webex Contact Center OAuth (required only for "live" mode) ---
# Register an Integration at https://developer.webex-cx.com (scope: cjp:user)
WEBEX_CLIENT_ID=
WEBEX_CLIENT_SECRET=
WEBEX_REDIRECT_URI=http://localhost:8080/api/auth/callback
# Region base URL for REST calls, e.g. https://api.wxcc-us1.cisco.com
WXCC_API_BASE_URL=https://api.wxcc-us1.cisco.com
# Your org's Webex Contact Center org ID, used to list Teams -- find it in Control Hub
WXCC_ORG_ID=

# --- Web Push (used for incoming-task alerts, works in both mock and live mode) ---
# Generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
